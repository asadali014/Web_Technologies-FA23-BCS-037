<%
  /* Page meta for layout */
  locals.title      = 'Sales Dashboard — Daraz';
  locals.activePage = 'sales';
%>

<style>
  /* ── Sales Dashboard Styles ──────────────────────────────── */
  :root {
    --bg:#0b0c15;--surface:#13141f;--card:#1a1b2e;
    --accent:#e63946;--green:#4ade80;--yellow:#fbbf24;
    --red:#f87171;--blue:#60a5fa;--purple:#a78bfa;
    --text:#e2e8f0;--muted:#64748b;--border:rgba(255,255,255,.07);--r:12px
  }

  .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem}
  .topbar h1{font-size:1.55rem;font-weight:800}
  .live-badge{display:flex;align-items:center;gap:.5rem;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.25);border-radius:20px;padding:.3rem .85rem;font-size:.78rem;font-weight:600;color:var(--green)}
  .live-dot{width:8px;height:8px;background:var(--green);border-radius:50%;animation:pulse 1.5s infinite}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
  .last-updated{font-size:.73rem;color:var(--muted);margin-top:.15rem}

  /* ── Stat Cards ── */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;margin-bottom:1.75rem}
  .stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.4rem 1.2rem;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}
  .stat-card:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(0,0,0,.35)}
  .stat-card::before{content:'';position:absolute;inset:0;opacity:.06;border-radius:var(--r)}
  .sc-revenue::before{background:var(--green)}
  .sc-orders::before{background:var(--blue)}
  .sc-top::before{background:var(--yellow)}
  .sc-avg::before{background:var(--purple)}
  .stat-icon{font-size:1.8rem;margin-bottom:.5rem}
  .stat-label{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.3rem}
  .stat-value{font-size:1.9rem;font-weight:800;line-height:1;transition:color .3s}
  .sc-revenue .stat-value{color:var(--green)}
  .sc-orders  .stat-value{color:var(--blue)}
  .sc-top     .stat-value{font-size:1.1rem;color:var(--yellow);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .sc-avg     .stat-value{color:var(--purple)}

  /* ── Flash on update ── */
  @keyframes flashUpdate{0%{background:rgba(74,222,128,.18)}100%{background:transparent}}
  .stat-card.updated{animation:flashUpdate .8s ease-out}

  /* ── Recent Orders Table ── */
  .section-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:1.5rem}
  .section-header{padding:1rem 1.3rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
  .section-header h2{font-size:.95rem;font-weight:700}
  table{width:100%;border-collapse:collapse}
  thead th{padding:.65rem 1rem;text-align:left;font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border)}
  tbody tr{border-bottom:1px solid var(--border);transition:background .15s}
  tbody tr:last-child{border-bottom:none}
  tbody tr:hover{background:rgba(255,255,255,.025)}
  td{padding:.7rem 1rem;font-size:.83rem;vertical-align:middle}
  .status-pill{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.68rem;font-weight:700}
  .status-completed{background:rgba(74,222,128,.15);color:var(--green)}
  .status-pending  {background:rgba(251,191,36,.15);color:var(--yellow)}
  .status-cancelled{background:rgba(248,113,113,.15);color:var(--red)}

  /* ── Empty state ── */
  .empty-state{text-align:center;padding:3rem;color:var(--muted)}
  .empty-state .e-icon{font-size:3rem;margin-bottom:.8rem}

  /* ── Error toast ── */
  #poll-error{display:none;position:fixed;bottom:1.2rem;right:1.2rem;background:#1a1b2e;border:1px solid rgba(248,113,113,.4);color:var(--red);padding:.6rem 1.2rem;border-radius:8px;font-size:.82rem;z-index:999}
</style>

<div class="topbar">
  <div>
    <h1>💹 Sales Dashboard</h1>
    <div class="last-updated">Last updated: <span id="last-updated-time">Just loaded</span></div>
  </div>
  <div class="live-badge"><span class="live-dot"></span> Live · Updates every 10s</div>
</div>

<!-- ── Stat Cards ───────────────────────────────────────── -->
<div class="stats-grid">

  <div class="stat-card sc-revenue" id="card-revenue">
    <div class="stat-icon">💰</div>
    <div class="stat-label">Total Revenue</div>
    <div class="stat-value" id="stat-revenue">$<%= salesData.totalRevenue.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
  </div>

  <div class="stat-card sc-orders" id="card-orders">
    <div class="stat-icon">🛒</div>
    <div class="stat-label">Total Orders</div>
    <div class="stat-value" id="stat-orders"><%= salesData.totalOrders %></div>
  </div>

  <div class="stat-card sc-top" id="card-top">
    <div class="stat-icon">🏆</div>
    <div class="stat-label">Top-Selling Product</div>
    <div class="stat-value" id="stat-top"><%= salesData.topProduct || 'N/A' %></div>
  </div>

  <div class="stat-card sc-avg" id="card-avg">
    <div class="stat-icon">📈</div>
    <div class="stat-label">Avg. Order Value</div>
    <div class="stat-value" id="stat-avg">$<%= salesData.avgOrderValue.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
  </div>

</div>

<!-- ── Recent Orders ─────────────────────────────────────── -->
<div class="section-card">
  <div class="section-header">
    <h2>📋 Recent Orders</h2>
    <span style="font-size:.75rem;color:var(--muted)">Showing last 10</span>
  </div>
  <div style="overflow-x:auto" id="orders-table-wrap">
    <% if (salesData.recentOrders && salesData.recentOrders.length > 0) { %>
    <table id="orders-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>User</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody id="orders-tbody">
        <% salesData.recentOrders.forEach(function(order) { %>
        <tr>
          <td style="font-family:monospace;font-size:.75rem;color:var(--muted)"><%= String(order._id).slice(-8).toUpperCase() %></td>
          <td><%= order.user ? (order.user.name || order.user.email || 'User') : 'Guest' %></td>
          <td style="font-weight:700;color:var(--green)">$<%= order.totalAmount.toFixed(2) %></td>
          <td><span class="status-pill status-<%= order.status %>"><%= order.status %></span></td>
          <td style="color:var(--muted)"><%= new Date(order.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state">
      <div class="e-icon">📭</div>
      <p>No orders placed yet.</p>
    </div>
    <% } %>
  </div>
</div>

<!-- ── Error Toast ────────────────────────────────────────── -->
<div id="poll-error">⚠️ Failed to refresh data. Retrying…</div>

<!-- ── Client-Side Live Polling ──────────────────────────── -->
<script>
(function ($) {

  /* Helper: flash a card on update */
  function flashCard(id) {
    var $c = $('#' + id);
    $c.removeClass('updated');
    void $c[0].offsetWidth; // trigger reflow
    $c.addClass('updated');
  }

  /* Helper: format currency */
  function fmtMoney(n) {
    return '$' + parseFloat(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /* Helper: build one order row */
  function buildOrderRow(order) {
    var shortId = order._id ? String(order._id).slice(-8).toUpperCase() : '--------';
    var userName = (order.user && (order.user.name || order.user.email)) ? (order.user.name || order.user.email) : 'Guest';
    var statusClass = 'status-' + (order.status || 'pending');
    var dateStr = order.createdAt
      ? new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      : '—';
    return '<tr>' +
      '<td style="font-family:monospace;font-size:.75rem;color:var(--muted)">' + shortId + '</td>' +
      '<td>' + userName + '</td>' +
      '<td style="font-weight:700;color:var(--green)">$' + parseFloat(order.totalAmount).toFixed(2) + '</td>' +
      '<td><span class="status-pill ' + statusClass + '">' + (order.status || 'pending') + '</span></td>' +
      '<td style="color:var(--muted)">' + dateStr + '</td>' +
      '</tr>';
  }

  /* ── Poll every 10 seconds ── */
  function pollSalesData() {
    $.ajax({
      url: '/api/sales-data',
      method: 'GET',
      dataType: 'json',
      success: function (data) {
        /* Update stat cards */
        $('#stat-revenue').text(fmtMoney(data.totalRevenue));
        flashCard('card-revenue');

        $('#stat-orders').text(data.totalOrders);
        flashCard('card-orders');

        $('#stat-top').text(data.topProduct || 'N/A');
        flashCard('card-top');

        $('#stat-avg').text(fmtMoney(data.avgOrderValue));
        flashCard('card-avg');

        /* Update recent orders table */
        if (data.recentOrders && data.recentOrders.length > 0) {
          var rows = '';
          data.recentOrders.forEach(function (order) {
            rows += buildOrderRow(order);
          });

          if ($('#orders-tbody').length) {
            $('#orders-tbody').html(rows);
          } else {
            /* Replace empty-state with table */
            $('#orders-table-wrap').html(
              '<table id="orders-table">' +
              '<thead><tr><th>Order ID</th><th>User</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>' +
              '<tbody id="orders-tbody">' + rows + '</tbody></table>'
            );
          }
        }

        /* Update timestamp */
        var now = new Date();
        $('#last-updated-time').text(now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));

        /* Hide error toast if visible */
        $('#poll-error').fadeOut(300);
      },
      error: function () {
        $('#poll-error').fadeIn(300);
      }
    });
  }

  /* Run immediately once DOM is ready, then every 10 s */
  $(document).ready(function () {
    setInterval(pollSalesData, 10000);
  });

}(jQuery));
</script>
